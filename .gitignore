# ── DONNÉES DE PATIENTS — ne doivent jamais être publiées ─────────────────────
# Tout le dossier est exclu, sauf ce qui est explicitement réadmis en dessous.
donnees/*
!donnees/README.md
!donnees/dictionnaire_variables.csv
!donnees/cohorte_synthetique.csv
!donnees/radiomique_synthetique.csv
!donnees/icc_perturbation_masque.csv

# archives : pourraient contenir des données
*.zip

# formats de données susceptibles de contenir des patients, où qu'ils soient
*.xlsx
*.xls
*.dta
*.sav
*.dcm
*.nii
*.nii.gz

# ── Sorties régénérables ──────────────────────────────────────────────────────
resultats/*
!resultats/.gitkeep

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/
*.egg-info/
.pytest_cache/

# ── Système ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
